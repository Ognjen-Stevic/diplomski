<a:Code>REQ_0021</a:Code>
<a:CreationDate>1784295169</a:CreationDate>
<a:Creator>ognje</a:Creator>
<a:ModificationDate>1789755142</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 Izvestaji zadrze kolicinu prodatih artikala pomnozenih sa stimulacijom po komadu. Npr:\line 10 artikala A * 50 rsd = 500 rsd\par
7 artikala B * 10 rsd = 70 rsd\par
sum = 570 rsd\line Izvestaji moraju da daju tacnu informaciju o prodatim flasama i balonima, ukupno prodatih litara za period, stimulaciju, gratise.\par
}
</a:Description>
<c:Requirements>
<o:Requirement Id="o28">
<a:ObjectID>F44BE4F7-4F89-4D16-9D32-1C2DD37F8864</a:ObjectID>
<a:Requirement.Title>Mesecni izvestaj</a:Requirement.Title>
<a:Code>REQ_0022</a:Code>
<a:CreationDate>1784296423</a:CreationDate>
<a:Creator>ognje</a:Creator>
<a:ModificationDate>1789481603</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 Svaki komercijalista vidi svoj napredak u toku trenutog meseca i istoriju proslih meseci. Izvestaj daje opciju za odabir meseca i godine. Izvestaj prikazuje: prodate flase, prodate balone, ukupno prodato litra, mesecna stimulacija i tabelu sa kolinama: proizvod (naziv), kolicina, broj litara po artiklu, stimulacija po artiklu i ukupna stimulacija za artikal.\par
}
</a:Description>
</o:Requirement>
