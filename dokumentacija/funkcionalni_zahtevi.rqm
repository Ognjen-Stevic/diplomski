<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 Procena putem stabla odlu\u269?ivanja mogu\u263?a je kada kupac postoji najmanje 90 dana, ima najmanje tri zavr\u353?ena redovna trebovanja u poslednjih 90 dana i vi\u353?e od nula prodatih litara u poslednjih 60 dana. U suprotnom prikazuje se status INSUFFICIENT_DATA.\par
}
</a:Description>
</o:Requirement>
</c:Requirements>
</o:Requirement>
