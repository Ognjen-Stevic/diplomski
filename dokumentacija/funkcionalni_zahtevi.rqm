<a:ModificationDate>1794316218</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 AI analitika procenjuje rizik od smanjenja kupovine tokom narednih 60 dana, na osnovu istorije zavr\u353?enih redovnih trebovanja. Rezultati su dostupni komercijalisti, menad\u382?eru i CEO-u u skladu sa njihovim ovla\u353?\u263?enjima.\par
}
</a:Description>
<c:Requirements>
<o:Requirement Id="o118">
<a:ObjectID>DD5397B8-9716-410F-8DDB-A467A37688CC</a:ObjectID>
<a:Requirement.Title>Podaci za AI analizu</a:Requirement.Title>
<a:Code>REQ_0137</a:Code>
<a:CreationDate>1794316218</a:CreationDate>
<a:Creator>ognje</a:Creator>
<a:ModificationDate>1794320389</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 AI koristi istoriju zavr\f1\&#39;9a\f0 e\f1 nih trebovanja kako bi izra\&#39;e8unao \f0 podatke \f1  potrebne za procenu rizika kupca.\par
}
</a:Description>
<c:Requirements>
<o:Requirement Id="o119">
<a:ObjectID>6FDDF011-DC73-4E80-BF92-FF872C799C50</a:ObjectID>
<a:Requirement.Title>Izbor trebovanja za analizu</a:Requirement.Title>
<a:Code>REQ_0138</a:Code>
<a:CreationDate>1794316218</a:CreationDate>
<a:Creator>ognje</a:Creator>
<a:ModificationDate>1794316218</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 U AI analizu ulaze samo redovna trebovanja tipa NORMAL sa statusom COMPLETED. Gratis trebovanja, nezavr\u353?eni zahtevi i promet reklamnog materijala se ne uzimaju u obzir.\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o120">
<a:ObjectID>8A63F20D-BEFD-4B0C-82EC-7E2073EAD13C</a:ObjectID>
<a:Requirement.Title>Automatsko evidentiranje prodaje</a:Requirement.Title>
<a:Code>REQ_0139</a:Code>
<a:CreationDate>1794316218</a:CreationDate>
<a:Creator>ognje</a:Creator>
<a:ModificationDate>1794321039</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
