<a:ModificationDate>1794316218</a:ModificationDate>
<a:Modifier>ognje</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs20 Sistem \u269?uva vreme nastanka i evidentiranja zavr\u353?enog trebovanja, kao i istorijske podatke za obuku i pra\u263?enje procena. Za ranije datume koriste se samo podaci koji su u tom trenutku bili poznati sistemu.\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o123">
<a:ObjectID>5FE08914-FE7E-4B80-B860-616B3764ED9C</a:ObjectID>
