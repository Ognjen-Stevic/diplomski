# Copy this file to .env.properties for local development and replace every dummy value.
# .env.properties is ignored by Git and loaded without a Spring profile.
DB_URL=jdbc:postgresql://localhost:5432/diplomski_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=local-user@example.com
MAIL_PASSWORD=replace-with-mail-app-password
MAIL_FROM=local-user@example.com
